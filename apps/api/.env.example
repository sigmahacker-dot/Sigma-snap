# ── Server ────────────────────────────────────────────────
PORT=4000
WEB_URL=http://localhost:3000

# ── Database / cache ──────────────────────────────────────────
DATABASE_URL="postgresql://sigmasnap:sigmasnap@localhost:5432/sigmasnap?schema=public"
# Direct (non-pooled) connection, used by Prisma for migrations. On Supabase
# this is the port-5432 connection string; on localhost it can equal DATABASE_URL.
DIRECT_URL="postgresql://sigmasnap:sigmasnap@localhost:5432/sigmasnap?schema=public"
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────────────
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
ADMIN_TOTP_ENCRYPTION_KEY="change-me-totp-key"

# ── Storage (S3-compatible; MinIO defaults for local dev) ─────
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="sigmasnap"
S3_SECRET_KEY="sigmasnap123"
S3_BUCKET="sigmasnap"
S3_PUBLIC_URL="http://localhost:9000/sigmasnap"
S3_FORCE_PATH_STYLE="true"

# ── AI provider abstraction ───────────────────────────────────
# local = built-in offline procedural/heuristic provider (default, works without keys)
AI_PROVIDER="local"
AI_API_KEY=""
AI_MODEL=""

# ── Push notifications (provider abstraction) ─────────────────
PUSH_PROVIDER="noop"
FCM_SERVER_KEY=""
APNS_KEY_ID=""
APNS_TEAM_ID=""

# ── WebRTC ────────────────────────────────────────────────────
STUN_URLS="stun:stun.l.google.com:19302"
TURN_URL=""
TURN_USERNAME=""
TURN_CREDENTIAL=""

# ── Malware scanning (abstraction) ────────────────────────────
MALWARE_SCANNER="none"
CLAMAV_HOST=""

# ── Search (abstraction; postgres = built-in full-text) ──────
SEARCH_PROVIDER="postgres"
OPENSEARCH_URL=""

# ── OAuth (abstraction) ───────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
